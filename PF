fun menuGrupos() {
    val fmt = DateTimeFormatter.ofPattern("dd/MM/yy HH:mm:ss")
    println("""
        --- GERENCIAR GRUPOS ---
        1 - Criar grupo
        2 - Detalhes dos grupos
        3 - Adicionar membro (ID)
        4 - Remover membro (ID)
        5 - Renomear grupo
        0 - Voltar
        ------------------------
        Escolha uma opção: 
    """.trimIndent())
    when (readln().toIntOrNull()) {
        1 -> {
            print("Nome do Grupo: "); val n = readln().trim()
            if (n.any { it.isDigit() }) println("Erro: Nome do grupo não pode ter números.")
            else { grupos[n] = Grupo(n); println("Grupo criado!") }
        }
        2 -> {
            if (grupos.isEmpty()) println("Sem grupos cadastrados.")
            grupos.forEach { (nome, g) ->
                println("\nGRUPO: $nome | Criado: ${g.dataCriacao.format(fmt)}")
                println(" Membros: ${g.membros.size}")
                g.membros.forEach { (id, data) -> 
                    println("  -> ${agenda[id]?.nome} (Desde: ${data.format(fmt)})")
                }
                if (g.historicoRemovidos.isNotEmpty()) {
                    println(" Histórico: ${g.historicoRemovidos.joinToString(" | ")}")
                }
            }
        }
        3 -> {
            print("Grupo: "); val gNome = readln().trim()
            print("ID: "); val id = readln().toIntOrNull() ?: 0
            if (grupos.containsKey(gNome) && agenda.containsKey(id)) {
                grupos[gNome]?.membros?.set(id, LocalDateTime.now())
                println("Adicionado!")
            } else println("Erro: Dados não encontrados.")
        }
        4 -> {
            print("Grupo: "); val gNome = readln().trim()
            print("ID: "); val id = readln().toIntOrNull() ?: 0
            val g = grupos[gNome]
            if (g != null && g.membros.containsKey(id)) {
                val log = "${agenda[id]?.nome} (${LocalDateTime.now().format(fmt)})"
                g.membros.remove(id)
                g.historicoRemovidos.add(log)
                println("Removido e registrado!")
            }
        }
        5 -> {
            print("Nome atual: "); val atual = readln().trim()
            if (grupos.containsKey(atual)) {
                print("Novo nome: "); val novo = readln().trim()
                if (novo.any { it.isDigit() }) println("Erro: Nome não pode ter números.")
                else {
                    val g = grupos.remove(atual)!!
                    g.nome = novo
                    grupos[novo] = g
                    println("Renomeado!")
                }
            }
        }
    }
}

fun menuCemergencia() {
    println("""
        --- CONTATOS DE EMERGÊNCIA ---
        1 - Adicionar contato de emergência
        2 - Remover contato de emergência
        3 - Listar contatos de emergências
        0 - Voltar
        ------------------------------
        Escolha uma opção: 
    """.trimIndent())
    when (readln().toIntOrNull()) {
        1 -> {
            print("ID para adicionar: "); val id = readln().toIntOrNull()
            agenda[id]?.let { it.isEmergencia = true; println("${it.nome} agora é um contato de emergência!") } ?: println("ID não encontrado.")
        }
        2 -> {
            print("ID para remover: "); val id = readln().toIntOrNull()
            agenda[id]?.let { it.isEmergencia = false; println("${it.nome} removido como contato de emergência.") } ?: println("ID não encontrado.")
        }
        3 -> {
            val lista = agenda.filter { it.value.isEmergencia }
            if (lista.isEmpty()) println("Nenhum contato de emergência.")
            else lista.forEach { (id, c) -> println("ID: $id | Nome: ${c.nome} | Tel: ${formatarTelefone(c.telefone)}") }
        }
    }
}
