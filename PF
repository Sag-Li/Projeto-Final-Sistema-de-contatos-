import java.time.LocalDateTime
import java.time.format.DateTimeFormatter

data class Contato(
    var nome: String, 
    var telefone: String, 
    val data: LocalDateTime = LocalDateTime.now(),
    var isEmergencia: Boolean = false
)

data class Grupo(
    var nome: String,
    val dataCriacao: LocalDateTime = LocalDateTime.now(),
    val membros: MutableMap<Int, LocalDateTime> = mutableMapOf(),
    val historicoRemovidos: MutableList<String> = mutableListOf()
)

val agenda: MutableMap<Int, Contato> = mutableMapOf()
val grupos: MutableMap<String, Grupo> = mutableMapOf()

fun main() {
    do {
        exibirMenu()
        val opcao = readln().toIntOrNull() ?: -1
        when (opcao) {
            1 -> if (!adicionar()) return
            2 -> if (!buscar()) return
            3 -> if (!listar()) return
            4 -> if (!atualizar()) return
            5 -> if (!remover()) return
            6 -> if (!mais()) return
            0 -> { println("\nFechando a agenda!"); return }
            else -> println("\nOpção inválida! Tente novamente.")
        }
    } while (true)
}

fun continuar(): Boolean {
    println("\n-------------------------------------------")
    println("Digite 1 para voltar ao menu principal ou 0 para fechar o programa:")
    return readln().toIntOrNull() != 0
}

fun exibirMenu() {
    println("""
        --- GERENCIADOR DE CONTATOS ---
        1 - Adicionar contato
        2 - Buscar contato (por ID)
        3 - Listar contatos (ordenados)
        4 - Atualizar contato
        5 - Remover contato
        6 - Mais (+)
        0 - Sair
        -------------------------------
        Escolha uma opção: 
    """.trimIndent())
}

fun adicionar(): Boolean {
    print("Digite o ID: ")
    val id = readln().toIntOrNull()
    if (id == null || id <= 0) { println("Erro: ID inválido."); return continuar() }
    if (agenda.containsKey(id)) { println("Erro: ID já existe."); return continuar() }
    
    print("Digite o nome: ")
    val nome = readln().trim()
    
    if (nome.isEmpty() || nome.any { it.isDigit() }) { 
        println("Erro: O nome não pode ser vazio ou conter números.")
        return continuar() 
    }
    
    if (agenda.values.any { it.nome == nome }) { println("Erro: Nome já cadastrado."); return continuar() }
    
    print("Digite o telefone: ")
    val tel = readln().trim().filter { it.isDigit() }
    if (tel.length == 11 && tel.getOrNull(2) == '9') {
        agenda[id] = Contato(nome, tel)
        println("Contato adicionado com sucesso!")
    } else println("Erro: Número inválido, deve conter o DDD e o 9 logo após, antes do número.")
    return continuar()
}

fun formatarTelefone(tel: String) = "(${tel.substring(0, 2)}) ${tel.substring(2, 7)}-${tel.substring(7)}"

fun listar(): Boolean {
    if (agenda.isEmpty()) { println("Agenda vazia."); return continuar() }
    println("\n--- LISTA DE CONTATOS (Total: ${agenda.size}) ---")
    agenda.toSortedMap().forEach { (id, c) ->
        val gruposEmComum = grupos.filter { it.value.membros.containsKey(id) }.map { it.key }
        val printGrupos = if (gruposEmComum.isNotEmpty()) " | Grupos: ${gruposEmComum.joinToString(", ")}" else ""
        println("ID: $id | Nome: ${c.nome}$printGrupos | Tel: ${formatarTelefone(c.telefone)}")
    }
    return continuar()
}

fun buscar(): Boolean {
    print("ID: "); val id = readln().toIntOrNull()
    agenda[id]?.let {
        val par: Pair<String, String> = Pair(it.nome, it.telefone)
        println("Encontrado: ${par.first} | ${formatarTelefone(par.second)}")
    } ?: println("Não encontrado.")
    return continuar()
}

fun atualizar(): Boolean {
    print("ID: "); val id = readln().toIntOrNull()
    val c = agenda[id] ?: run { println("Não encontrado."); return continuar() }
    
    print("Novo nome: "); val n = readln().trim()
    if (n.isNotEmpty()) {
        if (n.any { it.isDigit() }) {
            println("Erro: Nome não pode conter números.")
        } else {
            c.nome = n
        }
    }
    
    print("Novo telefone: "); val t = readln().trim().filter { it.isDigit() }
    if (t.length == 11 && t.getOrNull(2) == '9') c.telefone = t
    
    println("Processo de atualização finalizado!")
    return continuar()
}

fun remover(): Boolean {
    print("ID para remover: "); val id = readln().toIntOrNull()
    if (agenda.containsKey(id)) {
        agenda.remove(id)
        grupos.values.forEach { it.membros.remove(id) }
        println("Removido!")
    } else println("Não encontrado.")
    return continuar()
}

fun mais(): Boolean {
    println("""
        --- OPÇÕES ADICIONAIS ---
        1 - Grupos
        2 - Contatos de emergência
        3 - Detalhes
        0 - Voltar
        -------------------------
        Escolha uma opção: 
    """.trimIndent())
    when (readln().toIntOrNull()) {
        1 -> menuGrupos()
        2 -> menuCemergencia()
        3 -> verDetalhes()
    }
    return if (agenda.isEmpty() && grupos.isEmpty()) true else continuar()
}

